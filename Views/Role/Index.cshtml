@model IEnumerable<WebApplication1.Models.Role>
@{
    ViewData["Title"] = "Roles Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h2 class="mb-4">
                <i class="fas fa-users-cog"></i> Game Roles Management
                <small class="text-muted">(@(Model?.Count() ?? 0) roles)</small>
            </h2>
            
            <!-- Action Buttons -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-tools"></i> Quick Actions</h5>
                </div>
                <div class="card-body">
                    <button class="btn btn-success me-2" data-bs-toggle="modal" data-bs-target="#addRoleModal">
                        <i class="fas fa-plus"></i> Add New Role
                    </button>
                    <button class="btn btn-info me-2" onclick="location.reload()">
                        <i class="fas fa-sync-alt"></i> Refresh
                    </button>
                </div>
            </div>
            
            <div class="card">
                <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Available Character Roles</h5>
                    <input type="text" class="form-control form-control-sm" 
                           placeholder="Search roles..." id="searchInput" style="width: 200px;">
                </div>
                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        <div class="row" id="rolesContainer">
                            @foreach (var role in Model.OrderBy(r => r.Name ?? ""))
                            {
                                <div class="col-lg-3 col-md-4 col-sm-6 mb-3 role-card" data-role-name="@((role.Name ?? "").ToLower())">
                                    <div class="card h-100 border-light shadow-sm">
                                        <div class="card-body text-center">
                                            <h6 class="card-title">
                                                <span class="badge badge-warning mb-2">🎭</span>
                                                <br>
                                                <strong class="role-name">@(role.Name ?? "Unknown")</strong>
                                            </h6>
                                            <p class="card-text">
                                                <span class="badge badge-secondary">ID: @role.roleId</span>
                                            </p>
                                            @if (!string.IsNullOrEmpty(role.Description))
                                            {
                                                <p class="text-muted small">@role.Description</p>
                                            }
                                        </div>
                                        <div class="card-footer bg-light">
                                            <div class="btn-group w-100">
                                                <button class="btn btn-sm btn-outline-primary" 
                                                        onclick="editRole(@role.roleId, '@(role.Name ?? "")')">
                                                    <i class="fas fa-edit"></i> Edit
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger" 
                                                        onclick="deleteRole(@role.roleId, '@(role.Name ?? "")')">
                                                    <i class="fas fa-trash"></i> Delete
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        
                        <div class="mt-3">
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle"></i>
                                <strong>Total Roles:</strong> <span id="totalCount">@Model.Count()</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning text-center">
                            <i class="fas fa-exclamation-triangle fa-2x mb-3"></i>
                            <h4>No roles found</h4>
                            <p>Start by adding your first character role!</p>
                            <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addRoleModal">
                                <i class="fas fa-plus"></i> Add First Role
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Role Modal -->
<div class="modal fade" id="addRoleModal" tabindex="-1" aria-labelledby="addRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="addRoleModalLabel">
                    <i class="fas fa-plus"></i> Add New Role
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addRoleForm">
                    <div class="mb-3">
                        <label for="newRoleName" class="form-label">Role Name *</label>
                        <input type="text" class="form-control" id="newRoleName" required>
                    </div>
                    <div class="mb-3">
                        <label for="newRoleDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="newRoleDescription" rows="3" placeholder="Optional role description"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" onclick="addRole()">
                    <i class="fas fa-plus"></i> Add Role
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Role Modal -->
<div class="modal fade" id="editRoleModal" tabindex="-1" aria-labelledby="editRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="editRoleModalLabel">
                    <i class="fas fa-edit"></i> Edit Role
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editRoleForm">
                    <input type="hidden" id="editRoleId">
                    <div class="mb-3">
                        <label for="editRoleName" class="form-label">Role Name *</label>
                        <input type="text" class="form-control" id="editRoleName" required>
                    </div>
                    <div class="mb-3">
                        <label for="editRoleDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="editRoleDescription" rows="3"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="updateRole()">
                    <i class="fas fa-save"></i> Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteRoleModal" tabindex="-1" aria-labelledby="deleteRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteRoleModalLabel">
                    <i class="fas fa-trash"></i> Confirm Delete
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <i class="fas fa-exclamation-triangle fa-3x text-warning mb-3"></i>
                <h6>Are you sure you want to delete:</h6>
                <strong id="deleteRoleName" class="text-danger"></strong>
                <p class="mt-2 text-muted small">This action cannot be undone!</p>
                <input type="hidden" id="deleteRoleId">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmDeleteRole()">
                    <i class="fas fa-trash"></i> Delete
                </button>
            </div>
        </div>
    </div>
</div>

<style>
.role-card.hidden {
    display: none;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Search functionality
    const searchInput = document.getElementById('searchInput');
    
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            const searchTerm = this.value.toLowerCase();
            const roleCards = document.querySelectorAll('.role-card');
            let visibleCount = 0;
            
            roleCards.forEach(card => {
                const roleName = card.getAttribute('data-role-name');
                if (roleName && roleName.includes(searchTerm)) {
                    card.classList.remove('hidden');
                    visibleCount++;
                } else {
                    card.classList.add('hidden');
                }
            });
            
            // Update count
            const totalCountElement = document.getElementById('totalCount');
            if (totalCountElement) {
                totalCountElement.textContent = visibleCount;
            }
        });
    }
});

async function addRole() {
    const roleName = document.getElementById('newRoleName').value.trim();
    const roleDescription = document.getElementById('newRoleDescription').value.trim();
    
    if (!roleName) {
        alert('Please enter a role name');
        return;
    }
    
    try {
        const response = await fetch('/api/roles', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                roleName: roleName,  // SỬA: đổi từ "Name" thành "roleName"
                Description: roleDescription || null
            })
        });
        
        if (response.ok) {
            alert('Role added successfully!');
            location.reload();
        } else {
            const errorText = await response.text();
            console.error('Error:', errorText);
            alert('Error adding role: ' + errorText);
        }
    } catch (error) {
        alert('Error: ' + error.message);
    }
}

function editRole(id, name) {
    fetch(`/api/roles/${id}`)
        .then(response => response.json())
        .then(role => {
            document.getElementById('editRoleId').value = id;
            document.getElementById('editRoleName').value = role.roleName || '';  // SỬA: đổi từ role.Name
            document.getElementById('editRoleDescription').value = role.Description || '';
            
            const editModal = new bootstrap.Modal(document.getElementById('editRoleModal'));
            editModal.show();
        })
        .catch(error => {
            console.error('Error loading role:', error);
            alert('Error loading role data');
        });
}

async function updateRole() {
    const id = document.getElementById('editRoleId').value;
    const roleName = document.getElementById('editRoleName').value.trim();
    const roleDescription = document.getElementById('editRoleDescription').value.trim();
    
    if (!roleName) {
        alert('Please enter a role name');
        return;
    }
    
    try {
        const response = await fetch(`/api/roles/${id}`, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                roleId: parseInt(id),
                roleName: roleName,  // SỬA: đổi từ "Name" thành "roleName"
                Description: roleDescription || null
            })
        });
        
        if (response.ok) {
            alert('Role updated successfully!');
            location.reload();
        } else {
            const errorText = await response.text();
            console.error('Error:', errorText);
            alert('Error updating role: ' + errorText);
        }
    } catch (error) {
        alert('Error: ' + error.message);
    }
}

function deleteRole(id, name) {
    document.getElementById('deleteRoleId').value = id;
    document.getElementById('deleteRoleName').textContent = name;
    const deleteModal = new bootstrap.Modal(document.getElementById('deleteRoleModal'));
    deleteModal.show();
}

async function confirmDeleteRole() {
    const id = document.getElementById('deleteRoleId').value;
    
    try {
        const response = await fetch(`/api/roles/${id}`, {
            method: 'DELETE'
        });
        
        if (response.ok) {
            alert('Role deleted successfully!');
            location.reload();
        } else {
            alert('Error deleting role');
        }
    } catch (error) {
        alert('Error: ' + error.message);
    }
}
</script>