@model IEnumerable<WebApplication1.Models.Region>
@{
    ViewData["Title"] = "Regions Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h2 class="mb-4">
                <i class="fas fa-globe-americas"></i> World Regions Management
                <small class="text-muted">(@(Model?.Count() ?? 0) regions)</small>
            </h2>
            
            <!-- Action Buttons -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-tools"></i> Quick Actions</h5>
                </div>
                <div class="card-body">
                    <button class="btn btn-success me-2" data-bs-toggle="modal" data-bs-target="#addRegionModal">
                        <i class="fas fa-plus"></i> Add New Region
                    </button>
                    <button class="btn btn-info me-2" onclick="location.reload()">
                        <i class="fas fa-sync-alt"></i> Refresh
                    </button>
                </div>
            </div>
            
            <div class="card">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Available Countries & Regions</h5>
                    <input type="text" class="form-control form-control-sm" 
                           placeholder="Search regions..." id="searchInput" style="width: 200px;">
                </div>
                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        <div class="row" id="regionsContainer">
                            @foreach (var region in Model.OrderBy(r => r.regionName))
                            {
                                <div class="col-lg-3 col-md-4 col-sm-6 mb-3 region-card" data-region-name="@region.regionName.ToLower()">
                                    <div class="card h-100 border-light shadow-sm">
                                        <div class="card-body text-center">
                                            <h6 class="card-title">
                                                <span class="badge badge-primary mb-2">🌍</span>
                                                <br>
                                                <strong class="region-name">@region.regionName</strong>
                                            </h6>
                                            <p class="card-text">
                                                <span class="badge badge-secondary">ID: @region.regionId</span>
                                            </p>
                                        </div>
                                        <div class="card-footer bg-light">
                                            <div class="btn-group w-100">
                                                <button class="btn btn-sm btn-outline-primary" 
                                                        onclick="editRegion(@region.regionId, '@region.regionName')">
                                                    <i class="fas fa-edit"></i> Edit
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger" 
                                                        onclick="deleteRegion(@region.regionId, '@region.regionName')">
                                                    <i class="fas fa-trash"></i> Delete
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        
                        <div class="mt-3">
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle"></i>
                                <strong>Total Regions:</strong> <span id="totalCount">@Model.Count()</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning text-center">
                            <i class="fas fa-exclamation-triangle fa-2x mb-3"></i>
                            <h4>No regions found</h4>
                            <p>Start by adding your first region!</p>
                            <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addRegionModal">
                                <i class="fas fa-plus"></i> Add First Region
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Region Modal -->
<div class="modal fade" id="addRegionModal" tabindex="-1" aria-labelledby="addRegionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="addRegionModalLabel">
                    <i class="fas fa-plus"></i> Add New Region
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addRegionForm">
                    <div class="mb-3">
                        <label for="newRegionName" class="form-label">Region Name *</label>
                        <input type="text" class="form-control" id="newRegionName" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Preview</label>
                        <div id="regionPreview" class="border p-3 text-center bg-light">
                            <span id="previewFlag">🌍</span><br>
                            <strong id="previewName">Enter region name...</strong>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" onclick="addRegion()">
                    <i class="fas fa-plus"></i> Add Region
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Region Modal -->
<div class="modal fade" id="editRegionModal" tabindex="-1" aria-labelledby="editRegionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="editRegionModalLabel">
                    <i class="fas fa-edit"></i> Edit Region
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editRegionForm">
                    <input type="hidden" id="editRegionId">
                    <div class="mb-3">
                        <label for="editRegionName" class="form-label">Region Name *</label>
                        <input type="text" class="form-control" id="editRegionName" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Preview</label>
                        <div id="editRegionPreview" class="border p-3 text-center bg-light">
                            <span id="editPreviewFlag">🌍</span><br>
                            <strong id="editPreviewName"></strong>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="updateRegion()">
                    <i class="fas fa-save"></i> Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteRegionModal" tabindex="-1" aria-labelledby="deleteRegionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteRegionModalLabel">
                    <i class="fas fa-trash"></i> Confirm Delete
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <i class="fas fa-exclamation-triangle fa-3x text-warning mb-3"></i>
                <h6>Are you sure you want to delete:</h6>
                <strong id="deleteRegionName" class="text-danger"></strong>
                <p class="mt-2 text-muted small">This action cannot be undone!</p>
                <input type="hidden" id="deleteRegionId">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmDeleteRegion()">
                    <i class="fas fa-trash"></i> Delete
                </button>
            </div>
        </div>
    </div>
</div>

<style>
.region-card.hidden {
    display: none;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Search functionality
    const searchInput = document.getElementById('searchInput');
    
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            const searchTerm = this.value.toLowerCụe();
            const regionCards = document.querySelectorAll('.region-card');
            let visibleCount = 0;
            
            regionCards.forEach(card => {
                const regionName = card.getAttribute('data-region-name');
                if (regionName && regionName.includes(searchTerm)) {
                    card.classList.remove('hidden');
                    visibleCount++;
                } else {
                    card.classList.add('hidden');
                }
            });
            
            // Update count
            const totalCountElement = document.getElementById('totalCount');
            if (totalCountElement) {
                totalCountElement.textContent = visibleCount;
            }
        });
    }
});

async function addRegion() {
    const regionName = document.getElementById('newRegionName').value.trim();
    
    if (!regionName) {
        alert('Please enter a region name');
        return;
    }
    
    try {
        const response = await fetch('/api/regions', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                regionName: regionName
            })
        });
        
        if (response.ok) {
            alert('Region added successfully!');
            location.reload();
        } else {
            alert('Error adding region');
        }
    } catch (error) {
        alert('Error: ' + error.message);
    }
}

function editRegion(id, name) {
    document.getElementById('editRegionId').value = id;
    document.getElementById('editRegionName').value = name;
    const editModal = new bootstrap.Modal(document.getElementById('editRegionModal'));
    editModal.show();
}

async function updateRegion() {
    const id = document.getElementById('editRegionId').value;
    const regionName = document.getElementById('editRegionName').value.trim();
    
    if (!regionName) {
        alert('Please enter a region name');
        return;
    }
    
    try {
        const response = await fetch(`/api/regions/${id}`, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                regionId: parseInt(id),
                regionName: regionName
            })
        });
        
        if (response.ok) {
            alert('Region updated successfully!');
            location.reload();
        } else {
            alert('Error updating region');
        }
    } catch (error) {
        alert('Error: ' + error.message);
    }
}

function deleteRegion(id, name) {
    document.getElementById('deleteRegionId').value = id;
    document.getElementById('deleteRegionName').textContent = name;
    const deleteModal = new bootstrap.Modal(document.getElementById('deleteRegionModal'));
    deleteModal.show();
}

async function confirmDeleteRegion() {
    const id = document.getElementById('deleteRegionId').value;
    
    try {
        const response = await fetch(`/api/regions/${id}`, {
            method: 'DELETE'
        });
        
        if (response.ok) {
            alert('Region deleted successfully!');
            location.reload();
        } else {
            alert('Error deleting region');
        }
    } catch (error) {
        alert('Error: ' + error.message);
    }
}
</script>

